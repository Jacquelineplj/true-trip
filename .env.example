# Copy to .env and enter your own key. Never place credentials in extension files.
OPENAI_API_KEY=
TRUETRIP_LLM_PROVIDER=openai
TRUETRIP_OPENAI_MODEL=gpt-4o-mini
TRUETRIP_RATINGS_FALLBACK=llm
TRUETRIP_PARKING_MODE=search

# Maximum simultaneous model requests across all hotel/venue lookups (1-12).
TRUETRIP_AI_CONCURRENCY=6
